# ---------------------------------------------------------------------------
node_modules/
package-lock.json
package.json

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.vscode/
.idea/

# Texture-generator corpus: derived from FFHQ, ~2 GB of uint8 shards.
data/texgen/
data/texgen_cache/
runs/texgen*/

# Compiled CUDA scratch binaries (source in cuda/ is tracked)
cuda/raster
cuda/*.o
cuda/*.exe

# Local build helper, machine-specific paths
cuda/_build_env.bat
cuda/_profile_env.bat
cuda/*.ncu-rep

